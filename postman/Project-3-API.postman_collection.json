{
  "info": {
    "_postman_id": "7b70104e-54bb-4f05-b3ab-827be15d1d24",
    "name": "Project 3 - Shift Builder API",
    "description": "API checks for the school specification. Set baseUrl and adminToken before administrator-only requests. Run registration before user requests; its test saves the JWT and user ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "shiftId", "value": "" },
    { "key": "commentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check API",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API is healthy', function () { pm.response.to.have.status(200); });"] } }]
        }
      ]
    },
    {
      "name": "Authentication and users",
      "item": [
        {
          "name": "Register regular user",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('testEmail', `student-${Date.now()}@example.com`);"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('User registered', function () { pm.response.to.have.status(201); });", "const data = pm.response.json();", "pm.collectionVariables.set('token', data.token);", "pm.collectionVariables.set('userId', data.user._id);"] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user\": {\n    \"email\": \"{{testEmail}}\",\n    \"password\": \"Project-test-2026!\",\n    \"firstname\": \"Student\",\n    \"lastname\": \"Test\"\n  }\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Log in as regular user",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login succeeded', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Project-test-2026!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }
        },
        {
          "name": "Get current user",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Admin - list users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/users" }
        }
      ]
    },
    {
      "name": "Shifts",
      "item": [
        {
          "name": "Create shift",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Shift created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('shiftId', pm.response.json().shift._id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{userId}}\",\n  \"shift\": {\n    \"start\": \"2026-10-12T09:00:00.000Z\",\n    \"end\": \"2026-10-12T17:00:00.000Z\",\n    \"perHour\": 25,\n    \"place\": \"Main office\"\n  }\n}" }, "url": "{{baseUrl}}/api/shifts/" }
        },
        {
          "name": "Get shift by ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{shiftId}}\"\n}" }, "url": "{{baseUrl}}/api/shifts/" }
        },
        {
          "name": "Update shift using specification body",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{shiftId}}\",\n  \"shift\": { \"place\": \"Updated office\" }\n}" }, "url": "{{baseUrl}}/api/shifts/" }
        },
        {
          "name": "Regular user - list shifts (expect 403)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Only administrators can list all shifts', function () { pm.response.to.have.status(403); });"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/shifts/" }
        },
        {
          "name": "Admin - list all shifts",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/shifts/" }
        },
        {
          "name": "Admin - delete shift using specification body",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{shiftId}}\",\n  \"user\": {}\n}" }, "url": "{{baseUrl}}/api/shifts/" }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create comment",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Comment created', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('commentId', pm.response.json().comment._id);"] } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"comment\": { \"description\": \"Shift completed successfully.\" }\n}" }, "url": "{{baseUrl}}/api/comment/" }
        },
        {
          "name": "Get comment by ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/comment/{{commentId}}" }
        },
        {
          "name": "Get comments by user",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/comment/user/{{userId}}" }
        },
        {
          "name": "Update comment using specification body",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{commentId}}\",\n  \"comment\": { \"description\": \"Updated shift comment.\" }\n}" }, "url": "{{baseUrl}}/api/comment/" }
        },
        {
          "name": "Admin - get all comments",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/comment/" }
        },
        {
          "name": "Admin - delete comment",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"_id\": \"{{commentId}}\",\n  \"user\": {}\n}" }, "url": "{{baseUrl}}/api/comment/" }
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Get permissions",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/permission/" }
        }
      ]
    }
  ]
}
